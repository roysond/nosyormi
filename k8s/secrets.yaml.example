# Template only — safe to commit. Copy or use kubectl; never commit secrets.yaml.
#
# Preferred (no secrets file on disk):
#   kubectl create secret generic nosyormi-secrets \
#     --from-literal=OPENROUTER_API_KEY='your_openrouter_key_here' \
#     --dry-run=client -o yaml | kubectl apply -f -
#
apiVersion: v1
kind: Secret
metadata:
  name: nosyormi-secrets
type: Opaque
stringData:
  OPENROUTER_API_KEY: your_openrouter_api_key_here
