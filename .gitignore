# ─── macOS system files ──────────────────────────────
# Mac generates these automatically. They're useless to anyone else.
.DS_Store
.AppleDouble
.LSOverride

# ─── Secrets & environment variables ─────────────────
# API keys and passwords — NEVER commit. Safe templates: .env.example only.
.env
.env.*
!.env.example
.env.local
.env.*.local
*.env
!*.env.example
secrets.json
appsettings.Development.json
appsettings.Local.json
appsettings.*.json
!appsettings.json

# ─── .NET backend ────────────────────────────────────
# Build outputs and compiled binaries — regenerated on every build.
bin/
obj/
*.dll
*.exe
*.pdb

# .NET user secrets store (alternative to .env for .NET)
*.user
*.suo

# NuGet packages (restored from package manifest, not committed)
packages/
*.nupkg

# ─── Node.js / React frontend ────────────────────────
# Massive folder of downloaded libraries. Never commit. Reinstalled via `npm install`.
node_modules/

# Vite & React build outputs
dist/
build/
.vite/

# npm/yarn debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── IDE & editor files ──────────────────────────────
# Personal editor settings — shouldn't be shared with others.
.vscode/
.idea/
*.swp
*.swo
.cursor/

# ─── Logs & temporary files ──────────────────────────
*.log
logs/
*.tmp
.cache/

# ─── Docker ──────────────────────────────────────────
# Local Docker overrides (often contain credentials)
docker-compose.override.yml

# ─── Python (just in case we use scripts) ────────────
__pycache__/
*.pyc
.venv/
venv/

# ─── Database files ──────────────────────────────────
# Local SQLite files or DB dumps — never commit user data.
*.db
*.sqlite
*.sqlite3
*.bak

# ─── OS / misc ───────────────────────────────────────
Thumbs.db
ehthumbs.db
Desktop.ini

# ─── Kubernetes secrets (apply with kubectl; never commit real keys) ───
k8s/secrets.yaml
**/secrets.yaml
!k8s/secrets.yaml.example
