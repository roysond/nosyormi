# ─── NOSYOR.M.I — Environment Variables Template ─────────────────
# Copy this file to `.env` and fill in your real values.
# Never commit your actual .env file — it's gitignored for a reason.

# ─── Database ────────────────────────────────────────────────────
# PostgreSQL connection string. Format:
#   Host=localhost;Port=5432;Database=nosyormi;Username=youruser;Password=yourpass
DATABASE_CONNECTION_STRING=Host=localhost;Port=5432;Database=nosyormi;Username=your_db_user;Password=your_db_password

# ─── AI / OpenRouter ─────────────────────────────────────────────
# Get your key from https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# NOSYOR.M.I uses different models for different jobs (multi-model orchestration).
# Pick whichever model fits each task. See OpenRouter docs for full list:
# https://openrouter.ai/models

# Fast & cheap — used for high-volume, low-complexity tasks
# (e.g., transaction categorization fallback, simple labelling).
# Suggested options: openai/gpt-4o-mini, google/gemini-2.0-flash-lite, mistralai/mistral-small
MODEL_LIGHT=openai/gpt-4o-mini

# Mid-tier — used for narration & explanation
# (e.g., anomaly explanations, forecast summaries).
# Suggested options: openai/gpt-4o-mini, anthropic/claude-3.5-haiku, google/gemini-2.0-flash
MODEL_NARRATION=openai/gpt-4o-mini

# Premium reasoning — used for the chat interface and agentic features.
# This is the showcase model. Use sparingly to control cost.
# Suggested options: openai/gpt-4o, anthropic/claude-sonnet-4, google/gemini-2.5-pro
MODEL_CHAT=openai/gpt-4o

# ─── API configuration ───────────────────────────────────────────
# Port the .NET API listens on locally
API_PORT=5000

# Allowed frontend origin (for CORS)
FRONTEND_ORIGIN=http://localhost:5173

# ─── Environment ─────────────────────────────────────────────────
# Options: Development | Staging | Production
ASPNETCORE_ENVIRONMENT=Development


# ─── Embeddings ──────────────────────────────────────────────────
# Model used for vector embeddings (transaction descriptions, summaries).
# 1536D is the sweet spot for financial text — not too large, not too small.
# Suggested options: openai/text-embedding-3-small, voyage/voyage-3-lite
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# ─── Locale defaults ─────────────────────────────────────────────
# NOSYOR.M.I defaults to USA-style formatting.
# These can be overridden per user in the future (toggle feature planned).
DEFAULT_CURRENCY=USD
DEFAULT_DATE_FORMAT=MM/dd/yyyy
DEFAULT_LOCALE=en-US